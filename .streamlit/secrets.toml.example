# Copy to .streamlit/secrets.toml for LOCAL sign-in testing (git-ignored), or paste the same content
# into Streamlit Community Cloud -> App settings -> Secrets for the deployed app.

APP_ENV = "production"  # default; authentication is required. Use "local" only for private local development.

# Top-level keys become environment variables and OVERRIDE .env. Locally keep them in .env (leave these commented);
# on Streamlit Cloud uncomment and fill them.
# OPENROUTER_API_KEY = "sk-or-..."
# TAVILY_API_KEY = "tvly-..."
# TURSO_DATABASE_URL = "libsql://<database>-<org>.<region>.turso.io"
# TURSO_AUTH_TOKEN = "<turso auth token>"
# ADMIN_EMAILS = "you@example.com"   # admin rights also require the provider to report the email as verified

# Sign-in (Streamlit st.login, OpenID Connect). Required in production: [auth] plus AT LEAST ONE provider below.
# Each provider shows a button on the Sign in page. Remove the sections you do not use.
[auth]
redirect_uri = "http://localhost:8501/oauth2callback"  # cloud: https://<your-app>.streamlit.app/oauth2callback
cookie_secret = "<random string: python -c 'import secrets; print(secrets.token_hex(32))'>"

# Google: Google Cloud Console -> APIs & Services -> Credentials -> OAuth client ID (Web application).
[auth.google]
client_id = "<client id>.apps.googleusercontent.com"
client_secret = "<client secret>"
server_metadata_url = "https://accounts.google.com/.well-known/openid-configuration"

# Microsoft (personal and work accounts): Microsoft Entra admin center -> App registrations -> New registration.
# Use "common" for any account, or your tenant id to restrict sign-in to one organisation.
[auth.microsoft]
client_id = "<application (client) id>"
client_secret = "<client secret value>"
server_metadata_url = "https://login.microsoftonline.com/common/v2.0/.well-known/openid-configuration"

# Email sign-up and sign-in: a hosted OIDC provider that handles accounts, passwords, email verification and resets,
# for example Auth0 (Applications -> Create Application -> Regular Web Application; enable the Username-Password
# database connection with sign-ups). Passwords are entered on the provider's page; this app never sees them.
[auth.email]
client_id = "<auth0 client id>"
client_secret = "<auth0 client secret>"
server_metadata_url = "https://<your-tenant>.<region>.auth0.com/.well-known/openid-configuration"
